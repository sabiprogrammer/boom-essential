# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output and caches
/.next/
/out/
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# environment files and secrets (never commit real secrets; only the example file is tracked)
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json

# supabase (local CLI state and secrets; migrations and config ARE tracked)
/supabase/.branches
/supabase/.temp
/supabase/.env
/supabase/seed.local.sql

# testing and reports
/coverage
/.nyc_output
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deployment
.vercel

# operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# editors and IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Claude Code: personal, machine-local settings (project CLAUDE.md is tracked)
.claude/settings.local.json
.claude/worktrees/

# scratch files and local exports (customer data must never be committed)
*.tmp
*.bak
/tmp/
/scratch/
/exports/
*.csv
