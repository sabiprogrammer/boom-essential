# Copy to .env.local for local development. Never commit real values.
# .env.local is git-ignored (.env* rule); only this example file is tracked.

# Supabase (Stage 6). Both values come from the Supabase dashboard: Project Settings > API.
# They are public by design (the key only identifies the project; Row Level Security protects the data),
# so they may be NEXT_PUBLIC_. Add the same two names to the Vercel project's environment variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Administrator allowlist (Stage 6 authentication). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# One or more Supabase Auth user UUIDs (Dashboard > Authentication > Users), comma-separated. Only these
# accounts may enter /admin; being signed in is not enough. A missing, empty or malformed value denies everyone.
# The value below is a harmless placeholder, not a real account. Never commit a real id here.
BOOM_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# Rule: the Supabase service-role / secret key is server-only and must NEVER use a NEXT_PUBLIC_ prefix.
# It is not used yet and is not needed for the connection milestone. Do not add it until it is required.
